; ============================================================================
; Magic Keyboard Helper for Windows 11
; AutoHotkey v2 Script, run by the AutoHotkey64.exe next to it (MagicKeyboardHelper.bat).
; Not compiled on purpose: Windows Defender flags compiled builds (see "Start with Windows").
; ============================================================================
;
; Apple Magic Keyboard with Touch ID (A2449, Bluetooth) helper. Version 3.3.
; https://github.com/Mrlouder/magic-keyboard-helper-windows (MIT License)
; Not affiliated with or endorsed by Apple Inc.
;
;   Fn + F1-F12        actions set on the Settings > Fn keys tab (brightness, media...)
;   Fn lock            F1-F12 do those actions without Fn, Fn + F-key = plain F-key
;   Fn + Backspace     Delete
;   Fn + arrows        Home / End / Page Up / Page Down
;   Fn + Ctrl + arrows snap the window (Win + arrows)
;   Globe shortcuts    Fn + E emoji, C quick settings, N notifications, H desktop, F full screen
;   Lock (Touch ID)    lock the screen; hold 1.5 s = shut down dialog / shut down / sleep / display off
;   Double-tap F5      Dictation (Win+H)
;   Alt + wheel        volume
;   On-screen display  Mac-style overlay for brightness and volume
;   Key remaps         replaces PowerToys Keyboard Manager (stored in settings.ini)
;   Battery            level in the tray, time left estimate, charge reminders,
;                      green bolt icon while charging, orange dot icon when low
;
; The Fn and Lock keys only work after fn_lock_patch.bat: it rewrites the
; keyboard's Bluetooth HID descriptor so Fn is sent as F24 and Lock as F23.
;
; Settings: double-click the tray icon. Saved to settings.ini next to this script.
; Requires AutoHotkey v2 (https://www.autohotkey.com/).
; ============================================================================

#Requires AutoHotkey v2.0
#SingleInstance Force
Persistent

global APP := "Magic Keyboard Helper"
global APP_VERSION := "3.3"
global INI_FILE := A_ScriptDir "\settings.ini"
global ICON_FILE := A_ScriptDir "\magic_keyboard.ico"       ; icons are generated by make_icon.py
global ICON_CHARGING := A_ScriptDir "\magic_keyboard_charging.ico"
global ICON_LOW := A_ScriptDir "\magic_keyboard_low.ico"
global PATCH_BAT := A_ScriptDir "\fn_lock_patch.bat"
global TASK_NAME := "Magic Keyboard Helper"   ; Task Scheduler task that starts the app at sign-in
global RUN_KEY := "HKCU\Software\Microsoft\Windows\CurrentVersion\Run"   ; only to remove the v3.1 entry
global RUN_VALUE := "MagicKeyboardHelper"
global PT_ENGINE := "PowerToys.KeyboardManagerEngine.exe"
global VOLUME_STEP := 6.25              ; 1/16, like the 16 segments on a Mac
global LOCK_HOLD_SEC := 1.5

; Feature switches shown on the Settings > Features tab ([Features] section)
global FEATURES := [
    {id: "FnMedia",     def: 1, label: "Fn + F1-F12 actions (set them on the Fn keys tab)"},
    {id: "FnNav",       def: 1, label: "Fn + Backspace = Delete, Fn + arrows = Home / End / Page Up / Page Down"},
    {id: "FnGlobe",     def: 1, label: "Globe shortcuts: Fn + E emoji, C quick settings, N notifications, H desktop, F full screen"},
    {id: "FnSnap",      def: 1, label: "Fn + Ctrl + arrows = snap the window to a side (Win + arrows)"},
    {id: "LockKey",     def: 1, label: "Lock (Touch ID) key locks the screen"},
    {id: "F5Dictation", def: 1, label: "Double-tap F5 = Dictation (only while Fn lock is off)"},
    {id: "AltWheel",    def: 1, label: "Alt + mouse wheel = volume"},
    {id: "OSD",         def: 1, label: "Mac-style on-screen display for brightness and volume"},
    {id: "KeyRemaps",   def: 1, label: "Key remaps (see the Key remaps tab)"},
    {id: "PatchWarn",   def: 1, label: "Warn me when the Fn / Lock patch is missing (e.g. after pairing again)"},
]
global LOCK_HOLD := [
    ["shutdown", "Show the Shut Down Windows dialog"],
    ["poweroff", "Shut down the PC right away"],
    ["sleep",    "Sleep"],
    ["display",  "Turn off the display"],
    ["none",     "Nothing (lock right away on press)"],
]
; Actions for the Fn + F1-F12 keys: id -> [label, function]
global ACTIONS := Map(
    "none",          ["Nothing",                               (*) => 0],
    "fkey",          ["Plain F-key",                           (*) => 0],         ; handled in RunAction
    "brightDown",    ["Brightness down",                       (*) => BrightnessChange(-Cfg["BrightnessStep"])],
    "brightUp",      ["Brightness up",                         (*) => BrightnessChange(Cfg["BrightnessStep"])],
    "taskView",      ["Task View (Win+Tab)",                   (*) => Send("#{Tab}")],
    "search",        ["Search (Win+S)",                        (*) => Send("#s")],
    "dictation",     ["Dictation (Win+H)",                     (*) => Send("#h")],
    "audioSwitch",   ["Switch audio output (SoundSwitch)",     (*) => Send("!{F6}")],
    "notifications", ["Notifications / Do not disturb",        (*) => Send("#n")],
    "prevTrack",     ["Previous track",                        (*) => Send("{Media_Prev}")],
    "playPause",     ["Play / Pause",                          (*) => Send("{Media_Play_Pause}")],
    "nextTrack",     ["Next track",                            (*) => Send("{Media_Next}")],
    "mute",          ["Mute",                                  (*) => VolumeMute()],
    "volDown",       ["Volume down",                           (*) => VolumeStep(-1)],
    "volUp",         ["Volume up",                             (*) => VolumeStep(1)],
    "emoji",         ["Emoji panel (Win+.)",                   (*) => Send("#.")],
    "quickSettings", ["Quick settings (Win+A)",                (*) => Send("#a")],
    "desktop",       ["Show desktop (Win+D)",                  (*) => Send("#d")],
    "fullscreen",    ["Full screen (F11)",                     (*) => Send("{F11}")],
    "screenshot",    ["Screenshot (Win+Shift+S)",              (*) => Send("#+s")],
    "lock",          ["Lock the screen",                       (*) => DllCall("LockWorkStation")],
)
global ACTION_ORDER := ["none", "fkey", "brightDown", "brightUp", "taskView", "search", "dictation",
    "audioSwitch", "notifications", "prevTrack", "playPause", "nextTrack", "mute", "volDown", "volUp",
    "emoji", "quickSettings", "desktop", "fullscreen", "screenshot", "lock"]
; Fn + F1-F12 defaults: the icons printed on the Magic Keyboard
; (F6 = notifications / Do not disturb; "Switch audio output" needs SoundSwitch)
global FN_KEY_DEFAULTS := ["brightDown", "brightUp", "taskView", "search", "dictation", "notifications",
    "prevTrack", "playPause", "nextTrack", "mute", "volDown", "volUp"]
; Settings > Battery tab, stored in the [Battery] section
global BATTERY_SETTINGS := Map(
    "Battery", 1,               ; battery monitoring on / off
    "BattWarn", 1,              ; low battery reminder
    "BattWarnLevel", 20,        ;   at this level (%)
    "BattWarn2", 1,             ; second reminder
    "BattWarn2Level", 10,       ;   at this level (%)
    "BattRepeatMin", 60,        ; repeat the reminder while below the level (minutes, 0 = once)
    "BattChargeIcon", 1,        ; charging tray icon
    "BattLowIcon", 1,           ; orange dot tray icon below the reminder level
    "BattNotifyCharge", 1,      ; notify when charging starts and when fully charged
    "BattCheckMin", 1,          ; how often the battery is polled (minutes, live reports come anyway)
)
; Remaps are stored by scan code (the physical key), so they work with any Windows
; keyboard layout. No remaps by default. Apple ISO keyboards (UK, DE, HU, ...) send the
; key left of 1 and the key next to the left Shift swapped (sc056 <-> sc029); the
; "Apple ISO key fix" button on the Key remaps tab adds this swap.
global ISO_FIX_REMAPS := [[0x056, 0x029], [0x029, 0x056]]

global Cfg := Map()
global Remaps := []
global activeRemapHotkeys := []
global remapHeld := Map()               ; target scan code -> key sent on the press (for the release)
global battWarnedLevel := 101           ; lowest reminder level already shown in this discharge
global battLastWarnTick := 0
global battLastState := ""              ; "charging" / "full" / "discharging" / "" (unknown)
global battLastInfo := ""
global battPath := ""                   ; cached HID path of the battery collection
global battListen := {h: 0, ev: 0, buf: Buffer(3, 0), ov: Buffer(A_PtrSize * 3 + 8, 0)}   ; live report reader
global battHistory := []                ; [[timestamp, percent], ...] of the current discharge
global trayIconState := ""
global f5TapCount := 0
global settingsGui := 0
global patchWarned := false
global notifyAction := "", notifyTick := 0
global osd := {gui: 0, icon: 0, segs: [], text: 0, alpha: 0}

OnError(LogError)
CloseOtherInstances()
LoadSettings()

; ─── Tray icon and menu ──────────────────────────────────────────────────

A_IconTip := APP
SetTrayIcon("normal")

tray := A_TrayMenu
tray.Delete()
tray.Add(APP, (*) => 0)
tray.Disable(APP)
tray.Add()
global battMenuName := "Battery: ..."
tray.Add(battMenuName, (*) => UpdateBattery(true))   ; click = refresh + notification
tray.Add()
tray.Add("Settings...", (*) => ShowSettings())
tray.Default := "Settings..."                        ; double-click on the tray icon
tray.Add()
tray.Add("Reload", (*) => Reload())
tray.Add("Exit", (*) => ExitApp())
OnMessage(0x404, TrayIconMessage)                    ; notification clicks
OnMessage(0x0219, DeviceChanged)                     ; WM_DEVICECHANGE: USB cable / Bluetooth reconnect

Hotkey("F24", (*) => 0)                 ; Fn on its own does nothing
ApplyFeatures()
ApplyAutostart()
CheckPowerToysConflict()
SetTimer(CheckPatch, -4000)
if (A_Args.Length && A_Args[1] = "/settings")
    ShowSettings()

; ─── Settings (settings.ini) ─────────────────────────────────────────────

LoadSettings() {
    global Remaps, battHistory
    firstRun := !FileExist(INI_FILE)
    for f in FEATURES
        Cfg[f.id] := Integer(IniRead(INI_FILE, "Features", f.id, f.def))
    Cfg["FnLock"] := Integer(IniRead(INI_FILE, "Features", "FnLock", 0))
    Cfg["StartWithWindows"] := Integer(IniRead(INI_FILE, "Features", "StartWithWindows", 1))
    Cfg["BrightnessStep"] := Integer(IniRead(INI_FILE, "Features", "BrightnessStep", 10))
    Cfg["LockHold"] := IniRead(INI_FILE, "Features", "LockHold", "shutdown")
    if !LockHoldIndex(Cfg["LockHold"])
        Cfg["LockHold"] := "shutdown"
    Loop 12 {
        act := IniRead(INI_FILE, "FnKeys", "F" A_Index, FN_KEY_DEFAULTS[A_Index])
        Cfg["FnKey" A_Index] := ACTIONS.Has(act) ? act : FN_KEY_DEFAULTS[A_Index]
    }
    for key, def in BATTERY_SETTINGS {
        if (key = "Battery")            ; older settings.ini kept this switch under [Features]
            def := IniRead(INI_FILE, "Features", "Battery", def)
        Cfg[key] := Integer(IniRead(INI_FILE, "Battery", key, def))
    }
    battHistory := []
    Loop Parse IniRead(INI_FILE, "BatteryHistory", "Samples", ""), ","
        if RegExMatch(A_LoopField, "^(\d{14}):(\d+)$", &m)
            battHistory.Push([m[1], Integer(m[2])])
    Remaps := []
    if firstRun {
        ImportPowerToys()
        SaveSettings()
        return
    }
    try section := IniRead(INI_FILE, "Remaps")
    catch
        section := ""
    migrated := false
    Loop Parse section, "`n", "`r" {
        if RegExMatch(A_LoopField, "i)^\d+=sc([0-9A-F]{1,3})>sc([0-9A-F]{1,3})$", &m) {
            Remaps.Push([Integer("0x" m[1]), Integer("0x" m[2])])
        } else if RegExMatch(A_LoopField, "i)^\d+=([0-9A-F]{1,2})>([0-9A-F]{1,2})$", &m) {
            ; v3.2 and older stored virtual key codes: convert with the current layout
            from := VkToSc(Integer("0x" m[1])), to := VkToSc(Integer("0x" m[2]))
            if (from && to && from != to)
                Remaps.Push([from, to])
            migrated := true
        }
    }
    if migrated
        SaveSettings()
}

SaveSettings() {
    for f in FEATURES
        IniWrite(Cfg[f.id], INI_FILE, "Features", f.id)
    IniWrite(Cfg["FnLock"], INI_FILE, "Features", "FnLock")
    IniWrite(Cfg["StartWithWindows"], INI_FILE, "Features", "StartWithWindows")
    IniWrite(Cfg["BrightnessStep"], INI_FILE, "Features", "BrightnessStep")
    IniWrite(Cfg["LockHold"], INI_FILE, "Features", "LockHold")
    try IniDelete(INI_FILE, "Features", "Battery")
    Loop 12
        IniWrite(Cfg["FnKey" A_Index], INI_FILE, "FnKeys", "F" A_Index)
    for key in BATTERY_SETTINGS
        IniWrite(Cfg[key], INI_FILE, "Battery", key)
    try IniDelete(INI_FILE, "Remaps")
    lines := ""
    for i, r in Remaps
        lines .= (i > 1 ? "`n" : "") i "=" Format("sc{:03X}>sc{:03X}", r[1], r[2])
    if (lines != "")
        IniWrite(lines, INI_FILE, "Remaps")
}

LockHoldIndex(id) {
    for i, opt in LOCK_HOLD
        if (opt[1] = id)
            return i
    return 0
}

ActionIndex(id) {
    for i, a in ACTION_ORDER
        if (a = id)
            return i
    return 1
}

; ─── Hotkeys (registered dynamically, switched by the settings) ──────────
; Fn = F24 and Lock = F23 after fn_lock_patch.bat (otherwise they never fire).

SetHotkey(name, callback, on) => Hotkey(name, callback, on ? "On" : "Off")

ApplyFeatures() {
    Loop 12 {
        i := A_Index
        SetHotkey("F24 & F" i, FnFKey.Bind(i), Cfg["FnMedia"])
        ; $ = the script's own Send("{Fn}") does not retrigger it. No * on purpose:
        ; Alt+F4, Ctrl+F5 etc. keep their normal meaning.
        SetHotkey("$F" i, PlainFKey.Bind(i), (Cfg["FnMedia"] && Cfg["FnLock"]) || (i = 5 && Cfg["F5Dictation"]))
    }
    SetHotkey("F24 & Backspace", (*) => Send("{Blind}{Delete}"), Cfg["FnNav"])
    for dir, nav in Map("Left", "Home", "Right", "End", "Up", "PgUp", "Down", "PgDn")
        SetHotkey("F24 & " dir, FnArrow.Bind(dir, nav), Cfg["FnNav"] || Cfg["FnSnap"])
    for key, act in Map("e", "emoji", "c", "quickSettings", "n", "notifications", "h", "desktop", "f", "fullscreen")
        SetHotkey("F24 & " key, RunAction.Bind(act, 0), Cfg["FnGlobe"])
    SetHotkey("$F23", LockKeyPressed, Cfg["LockKey"])
    SetHotkey("!WheelUp", (*) => VolumeStep(1), Cfg["AltWheel"])
    SetHotkey("!WheelDown", (*) => VolumeStep(-1), Cfg["AltWheel"])
    ApplyRemaps()
    ApplyBattery()
}

RunAction(id, fkey := 0, *) {
    if (id = "fkey") {
        if fkey
            Send("{F" fkey "}")
    } else if ACTIONS.Has(id) {
        ACTIONS[id][2].Call()
    }
}

; Fn + F-key: the action, or with Fn lock the plain F-key
FnFKey(i, *) {
    if Cfg["FnLock"]
        Send("{F" i "}")
    else
        RunAction(Cfg["FnKey" i], i)
}

; F-key without Fn: only hooked with Fn lock (and F5 for the double-tap dictation)
PlainFKey(i, *) {
    if (Cfg["FnLock"] && Cfg["FnMedia"])
        RunAction(Cfg["FnKey" i], i)
    else if (i = 5 && Cfg["F5Dictation"])
        F5TapHandler()
    else
        Send("{F" i "}")
}

FnArrow(dir, nav, *) {
    if (Cfg["FnSnap"] && GetKeyState("Ctrl", "P"))
        Send("#{" dir "}")              ; Send releases the held Ctrl first, so this is a clean Win+arrow
    else if Cfg["FnNav"]
        Send("{Blind}{" nav "}")        ; Blind keeps Shift held, so Shift + Fn + arrow selects
    else
        Send("{Blind}{" dir "}")
}

; Short press = lock. Held for LOCK_HOLD_SEC = the chosen power action (like holding Touch ID on a Mac).
; The shut down actions fire as soon as the time is up, while the key is still held.
; Sleep and display off are only announced then and run after the key is released:
; releasing a key is input, and it would wake the PC / the display right away.
LockKeyPressed(*) {
    if (Cfg["LockHold"] = "none" || KeyWait("F23", "T" LOCK_HOLD_SEC)) {
        DllCall("LockWorkStation")
        return
    }
    switch Cfg["LockHold"] {
        case "shutdown":
            ShowOSD("power", 0, false, "Shut down...")
            ComObject("Shell.Application").ShutdownWindows()
        case "poweroff":
            ShowOSD("power", 0, false, "Shutting down")
            Shutdown(1 + 8)             ; shut down + power off, not forced: apps can still ask to save
        case "sleep":
            ShowOSD("power", 0, false, "Release the key to sleep")
            KeyWait("F23")
            Sleep(300)
            DllCall("PowrProf\SetSuspendState", "Int", 0, "Int", 0, "Int", 0)
        case "display":
            ShowOSD("power", 0, false, "Release the key to turn off the display")
            KeyWait("F23")
            Sleep(300)
            SendMessage(0x0112, 0xF170, 2, , "Program Manager")   ; WM_SYSCOMMAND / SC_MONITORPOWER / off
    }
    KeyWait("F23")
}

; ─── Error log ───────────────────────────────────────────────────────────
; A tray app must not stop on an error dialog (a key press can close the dialog
; with "Exit"). Errors go to error.log next to the app, with a short notification,
; and the app keeps running.

LogError(err, mode) {
    static lastNotify := 0
    try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss") "  " err.Message
        . (err.Extra != "" ? " (" err.Extra ")" : "") "  in " err.What " at line " err.Line "`n"
        . err.Stack "`n", A_ScriptDir "\error.log", "UTF-8")
    if (A_TickCount - lastNotify > 60000) {
        lastNotify := A_TickCount
        try Notify("Something went wrong, the details are in error.log. The app keeps running.", "Icon!")
    }
    return 1                            ; handled: no dialog, only this thread stops
}

; ─── Notifications (clickable) ───────────────────────────────────────────

Notify(text, icon := "Iconi", action := "") {
    global notifyAction, notifyTick
    notifyAction := action
    notifyTick := A_TickCount
    TrayTip(text, APP, icon)
}

TrayIconMessage(wParam, lParam, *) {
    global notifyAction
    if ((lParam & 0xFFFF) != 0x405 || notifyAction = "" || A_TickCount - notifyTick > 120000)
        return                          ; 0x405 = NIN_BALLOONUSERCLICK; anything else: default handling
    act := notifyAction
    notifyAction := ""
    if (act = "patch")
        Run('"' PATCH_BAT '"')
    else if (act = "settings")
        ShowSettings()
}

; ─── Key remaps (replaces PowerToys Keyboard Manager) ────────────────────
; Each remap is [source scan code, target scan code]: physical key -> physical key,
; so a remap means the same key with every Windows keyboard layout (a VK such as
; 0x30 is "0" on the number row with an English layout, but the key left of 1 with
; the Hungarian one). Extended keys have 0x100 set (Delete = sc153, RWin = sc15C).
; Implemented like AutoHotkey's own a::b remapping (blind down / up).

ApplyRemaps() {
    global activeRemapHotkeys
    for hk in activeRemapHotkeys
        try Hotkey(hk, "Off")
    activeRemapHotkeys := []
    if !Cfg["KeyRemaps"]
        return
    for r in Remaps {
        src := Format("*sc{:03X}", r[1])
        Hotkey(src, RemapDown.Bind(r[2]), "On")
        Hotkey(src " up", RemapUp.Bind(r[2]), "On")
        activeRemapHotkeys.Push(src, src " up")
    }
}

; Scan code of a VK with the current layout, with the extended bit. MapVirtualKey
; does not flag the navigation block as extended, hence the fixed list.
; (GetKeySC(name) is not used: for "í" it finds AltGr+J on the HU layout.)
VkToSc(vk) {
    static extended := Map(0x21,1, 0x22,1, 0x23,1, 0x24,1, 0x25,1, 0x26,1, 0x27,1, 0x28,1,
        0x2D,1, 0x2E,1, 0x5B,1, 0x5C,1, 0x5D,1, 0x6F,1, 0x90,1, 0xA3,1, 0xA5,1)
    r := DllCall("MapVirtualKeyW", "UInt", vk, "UInt", 4, "UInt")   ; MAPVK_VK_TO_VSC_EX
    sc := r & 0xFF
    if sc && ((r >> 8) = 0xE0 || extended.Has(vk))
        sc |= 0x100
    return sc
}

; The key to send for a target scan code: VK + scan code, the VK taken from the
; layout of the active window at the moment of the key press (layouts can be
; switched while the app runs). A bare {vk2E} would send the numpad sc053.
RemapKeyName(sc) {
    tid := DllCall("GetWindowThreadProcessId", "Ptr", WinExist("A"), "Ptr", 0, "UInt")
    hkl := DllCall("GetKeyboardLayout", "UInt", tid, "Ptr")
    code := (sc & 0x100) ? (0xE000 | (sc & 0xFF)) : sc
    vk := DllCall("MapVirtualKeyExW", "UInt", code, "UInt", 3, "Ptr", hkl, "UInt")   ; MAPVK_VSC_TO_VK_EX
    return vk ? Format("vk{:02X}sc{:03X}", vk, sc) : Format("sc{:03X}", sc)
}

RemapDown(sc, *) {
    global remapHeld
    if !remapHeld.Has(sc)               ; key repeat: keep the key picked on the first press
        remapHeld[sc] := RemapKeyName(sc)
    SetKeyDelay(-1)
    Send("{Blind}{" remapHeld[sc] " DownR}")
}

RemapUp(sc, *) {
    global remapHeld
    key := remapHeld.Has(sc) ? remapHeld.Delete(sc) : RemapKeyName(sc)
    SetKeyDelay(-1)
    Send("{Blind}{" key " Up}")
}

SetRemap(from, to) {
    for r in Remaps
        if (r[1] = from) {
            r[2] := to
            return
        }
    Remaps.Push([from, to])
}

; PowerToys stores virtual key codes, converted to scan codes with the current layout.
; Only single key -> single key remaps are imported (not shortcuts).
ImportPowerToys() {
    f := EnvGet("LOCALAPPDATA") "\Microsoft\PowerToys\Keyboard Manager\default.json"
    if !FileExist(f)
        return 0
    txt := FileRead(f)
    pos := 1, n := 0
    while (pos := RegExMatch(txt, '"originalKeys"\s*:\s*"(\d+)"\s*,\s*"newRemapKeys"\s*:\s*"(\d+)"', &m, pos)) {
        pos += m.Len
        from := VkToSc(Integer(m[1])), to := VkToSc(Integer(m[2]))
        if (from && to && from != to) {
            SetRemap(from, to)
            n++
        }
    }
    return n
}

PowerToysRunning() => ProcessExist(PT_ENGINE) != 0

CheckPowerToysConflict() {
    if (Cfg["KeyRemaps"] && Remaps.Length && PowerToysRunning())
        Notify("PowerToys Keyboard Manager is also running. Turn it off in PowerToys, "
            . "otherwise the key remaps are applied twice.", "Icon!")
}

; Name of a physical key (scan code); characters follow the current keyboard layout
KeyLabel(sc) {
    static friendly := Map(0x15B, "Left Command (LWin)", 0x15C, "Right Command (RWin)",
        0x038, "Left Option (LAlt)", 0x138, "Right Option (RAlt)", 0x076, "Fn (F24)", 0x06E, "Lock (F23)",
        0x153, "Delete", 0x00E, "Backspace", 0x039, "Space", 0x01C, "Enter", 0x001, "Esc", 0x00F, "Tab")
    if friendly.Has(sc)
        return friendly[sc]
    name := GetKeyName(Format("sc{:03X}", sc))
    if (name = "")
        return Format("Scan code 0x{:03X}", sc)
    return (StrLen(name) = 1 ? StrUpper(name) : name) Format("  (sc{:03X})", sc)
}

; ─── Single instance across .ahk and .exe ────────────────────────────────

; #SingleInstance only covers the same file, so the script and the compiled exe
; would both run (and remap every key twice). Close the other one.
CloseOtherInstances() {
    prev := A_DetectHiddenWindows
    DetectHiddenWindows(true)
    for hwnd in WinGetList("ahk_class AutoHotkey") {
        if (hwnd = A_ScriptHwnd)
            continue
        title := WinGetTitle(hwnd)
        if (InStr(title, "magic_keyboard_media.ahk") || InStr(title, "MagicKeyboardHelper.exe"))
            try WinClose(hwnd)
    }
    DetectHiddenWindows(prev)
}

; ─── Start with Windows ──────────────────────────────────────────────────
; The wish is stored in settings.ini (StartWithWindows); on every start the app
; makes a Task Scheduler task ("Magic Keyboard Helper", at log on, current user,
; no admin rights needed) match it.
; History: v3.0 used a Startup-folder shortcut, which Windows Defender deleted
; together with the compiled exe; v3.1 used HKCU\...\Run, which Windows silently
; skipped at log on on this PC (no Shell-Core 9707 event, other Run entries ran).
;
; The app runs as this script with the unchanged AutoHotkey64.exe copied next to it
; (no AutoHotkey install needed). A compiled exe is a new, unknown file after every
; build and Windows Defender's ML scanner flagged it (Trojan:Script/Conteban.A!ml,
; Program:Win32/Contebrew.A!ml).

AutostartTarget() {
    if A_IsCompiled
        return [A_ScriptFullPath, ""]
    ahk := FileExist(A_ScriptDir "\AutoHotkey64.exe") ? A_ScriptDir "\AutoHotkey64.exe" : A_AhkPath
    return [ahk, '"' A_ScriptFullPath '"']
}

TaskUser() => EnvGet("USERDOMAIN") "\" A_UserName

GetLogonTask() {
    svc := ComObject("Schedule.Service")
    svc.Connect()
    try return svc.GetFolder("\").GetTask(TASK_NAME)
    return ""
}

ApplyAutostart() {
    RemoveLegacyStartupLinks()
    try RegDelete(RUN_KEY, RUN_VALUE)                ; v3.1 entry, see above
    if Cfg["StartWithWindows"] {
        EnsureLogonTask()
    } else {
        svc := ComObject("Schedule.Service")
        svc.Connect()
        try svc.GetFolder("\").DeleteTask(TASK_NAME, 0)
    }
}

EnsureLogonTask() {
    target := AutostartTarget()
    if (task := GetLogonTask()) {
        act := task.Definition.Actions.Item(1)
        if (task.Enabled && act.Path = target[1] && act.Arguments = target[2])
            return                                   ; already right, keep it
    }
    svc := ComObject("Schedule.Service")
    svc.Connect()
    def := svc.NewTask(0)
    def.RegistrationInfo.Description := "Starts Magic Keyboard Helper when you sign in."
    def.Settings.ExecutionTimeLimit := "PT0S"        ; no limit (the default would stop it after 3 days)
    def.Settings.Priority := 4                       ; normal priority (default 7 = below normal)
    def.Settings.DisallowStartIfOnBatteries := false
    def.Settings.StopIfGoingOnBatteries := false
    def.Settings.MultipleInstances := 2              ; TASK_INSTANCES_IGNORE_NEW
    trig := def.Triggers.Create(9)                   ; TASK_TRIGGER_LOGON
    trig.UserId := TaskUser()
    trig.Delay := "PT5S"
    def.Principal.UserId := TaskUser()
    def.Principal.LogonType := 3                     ; interactive token: runs in your session
    def.Principal.RunLevel := 0                      ; no elevation
    act := def.Actions.Create(0)                     ; TASK_ACTION_EXEC
    act.Path := target[1]
    act.Arguments := target[2]
    act.WorkingDirectory := A_ScriptDir
    svc.GetFolder("\").RegisterTaskDefinition(TASK_NAME, def, 6, , , 3)   ; create or update
}

SetAutostart(on) {
    Cfg["StartWithWindows"] := on
    SaveSettings()
    ApplyAutostart()
}

; Old versions started from a shortcut in the Startup folder; the task replaces it.
RemoveLegacyStartupLinks() {
    Loop Files A_Startup "\*.lnk" {
        try {
            FileGetShortcut(A_LoopFileFullPath, &target, , &args)
            if (InStr(A_LoopFileName, "Magic Keyboard Helper") || InStr(target, "start_magic_keyboard.bat")
                || InStr(args, "magic_keyboard_media.ahk") || InStr(target, "MagicKeyboardHelper.exe"))
                FileDelete(A_LoopFileFullPath)
        }
    }
}

AutostartStatusText() {
    if !Cfg["StartWithWindows"]
        return "Off (Features tab)."
    try task := GetLogonTask()
    if !(IsSet(task) && task)
        return "Missing, it is added again on the next start."
    if !task.Enabled
        return "The task is disabled in Task Scheduler. Tick Start with Windows again to turn it on."
    return "On (Task Scheduler, at sign-in)."
}

; ─── Fn / Lock patch status (read-only registry check) ───────────────────

PatchStatus() {
    paired := false
    Loop Reg "HKLM\SYSTEM\CurrentControlSet\Services\BTHPORT\Parameters\Devices", "K" {
        key := A_LoopRegKey "\" A_LoopRegName
        try {
            if (RegRead(key, "VID") != 0x4C || RegRead(key, "PID") != 0x29C)
                continue
        } catch {
            continue
        }
        paired := true
        try data := RegRead(key "\CachedServices", "00010000")
        catch
            continue
        if InStr(data, "0607000973810205070900")
            return "active"
        if InStr(data, "0601FF0903810205")
            return "missing"
    }
    return paired ? "unknown" : "unpaired"
}

PatchStatusText() {
    switch PatchStatus() {
        case "active":   return "Active: Fn is sent as F24, Lock as F23."
        case "missing":  return "Not applied: the Fn and Lock keys do nothing yet."
        case "unpaired": return "The Magic Keyboard is not paired with this PC."
        default:         return "Unknown keyboard descriptor."
    }
}

; Pairing the keyboard again rewrites the descriptor cache, which removes the patch.
CheckPatch() {
    global patchWarned
    if (!Cfg["PatchWarn"] || patchWarned)
        return
    if (PatchStatus() = "missing") {
        patchWarned := true
        Notify("The Fn and Lock keys are not active (the keyboard was probably paired again). "
            . "Click here to apply the Fn / Lock patch.", "Icon!", "patch")
    }
}

; ─── Settings window ─────────────────────────────────────────────────────

ShowSettings(tabIndex := 1) {
    global settingsGui
    if settingsGui {
        settingsGui.Show()
        return
    }
    g := Gui(, APP " " APP_VERSION " Settings")
    g.SetFont("s9", "Segoe UI")
    g.OnEvent("Close", CloseSettings)
    g.OnEvent("Escape", CloseSettings)
    tab := g.Add("Tab3", "w560 h440", ["Features", "Fn keys", "Key remaps", "Battery", "Status"])

    ; Features
    tab.UseTab(1)
    g.Add("Text", "xm+14 ym+36 w530 cGray", "Changes apply immediately and are saved to settings.ini.")
    for f in FEATURES {
        cb := g.Add("CheckBox", "xm+14 y+10 w530 Checked" Cfg[f.id], f.label)
        cb.OnEvent("Click", FeatureToggled.Bind(f.id))
    }
    g.Add("Text", "xm+14 y+16", "When the Lock key is held for " LOCK_HOLD_SEC " s:")
    holdLabels := []
    for opt in LOCK_HOLD
        holdLabels.Push(opt[2])
    ddHold := g.Add("DropDownList", "x+8 yp-3 w250 Choose" LockHoldIndex(Cfg["LockHold"]), holdLabels)
    ddHold.OnEvent("Change", (c, *) => (Cfg["LockHold"] := LOCK_HOLD[c.Value][1], SaveSettings()))
    cbStart := g.Add("CheckBox", "xm+14 y+18 w530 Checked" Cfg["StartWithWindows"], "Start with Windows")
    cbStart.OnEvent("Click", (c, *) => SetAutostart(c.Value))

    ; Fn keys
    tab.UseTab(2)
    g.Add("Text", "xm+14 ym+36 w530 cGray", "What Fn + F1-F12 does. With Fn lock on, F1-F12 do this without Fn "
        . "and Fn + F-key gives the plain F-key (the Mac default).")
    cbLock := g.Add("CheckBox", "xm+14 y+12 w530 Checked" Cfg["FnLock"], "Fn lock: F1-F12 work as the keys printed on the keyboard")
    cbLock.OnEvent("Click", (c, *) => (Cfg["FnLock"] := c.Value, SaveSettings(), ApplyFeatures()))
    actLabels := []
    for id in ACTION_ORDER
        actLabels.Push(ACTIONS[id][1])
    Loop 12 {
        i := A_Index
        x := 14 + (i > 6 ? 275 : 0)
        y := 110 + Mod(i - 1, 6) * 36
        g.Add("Text", "xm+" x " ym+" (y + 4) " w30", "F" i)
        dd := g.Add("DropDownList", "xm+" (x + 32) " ym+" y " w225 Choose" ActionIndex(Cfg["FnKey" i]), actLabels)
        dd.OnEvent("Change", FnKeyChanged.Bind(i))
    }
    g.Add("Text", "xm+14 ym+340", "Brightness step for Fn + F1 / F2:")
    stepEdit := g.Add("Edit", "x+8 yp-3 w55 Number")
    g.Add("UpDown", "Range1-50", Cfg["BrightnessStep"])
    g.Add("Text", "x+6 yp+3", "%")
    stepEdit.OnEvent("Change", StepChanged)
    btnReset := g.Add("Button", "xm+14 y+18 w180", "Restore the defaults")
    btnReset.OnEvent("Click", ResetFnKeys)
    ResetFnKeys(*) {
        Loop 12
            Cfg["FnKey" A_Index] := FN_KEY_DEFAULTS[A_Index]
        SaveSettings()
        CloseSettings()
        ShowSettings(2)
    }

    ; Key remaps
    tab.UseTab(3)
    g.Add("Text", "xm+14 ym+36 w530 cGray", "Remaps one physical key to another key, like PowerToys Keyboard Manager.")
    lv := g.Add("ListView", "xm+14 y+8 w530 h150 -Multi NoSortHdr", ["Physical key", "Acts as"])
    pending := Map("from", 0, "to", 0)
    g.Add("Text", "xm+14 y+14", "New or changed remap:")
    btnFrom := g.Add("Button", "xm+14 y+6 w190", "Click, then press a key")
    g.Add("Text", "x+8 yp+5", "acts as")
    btnTo := g.Add("Button", "x+8 yp-5 w190", "Click, then press a key")
    btnAdd := g.Add("Button", "x+8 w90", "Add")
    btnDel := g.Add("Button", "xm+14 y+14 w170", "Remove selected")
    btnImp := g.Add("Button", "x+8 w170", "Import from PowerToys")
    btnIso := g.Add("Button", "x+8 w174", "Apple ISO key fix")
    g.Add("Text", "xm+14 y+10 w530 cGray", "Apple ISO key fix: on UK, German, Hungarian etc. (ISO) Apple keyboards Windows "
        . "swaps the key left of 1 and the key next to the left Shift. This adds a remap that swaps them back. "
        . "Not needed on US (ANSI) keyboards.")
    ptWarn := g.Add("Text", "xm+14 y+10 w530 h36 cRed")

    RefreshRemapList() {
        lv.Delete()
        for r in Remaps
            lv.Add(, KeyLabel(r[1]), KeyLabel(r[2]))
        lv.ModifyCol(1, 260)
        lv.ModifyCol(2, 260)
        ptWarn.Text := PowerToysRunning()
            ? "PowerToys Keyboard Manager is running. Turn it off in PowerToys (Keyboard Manager > Enable), otherwise the remaps are applied twice."
            : ""
    }
    Capture(btn, slot, *) {
        btn.Text := "Press a key..."
        res := {vk: 0, sc: 0}
        Suspend(true)                   ; capture the physical key, not its remap
        ih := InputHook("L0 T6")
        ih.KeyOpt("{All}", "NS")
        ih.OnKeyDown := (hook, vk, sc) => (res.vk := vk, res.sc := sc, hook.Stop())
        ih.Start()
        ih.Wait()
        Suspend(false)
        if (res.vk && !res.sc)
            res.sc := VkToSc(res.vk)
        if res.sc
            pending[slot] := res.sc
        btn.Text := pending[slot] ? KeyLabel(pending[slot]) : "Click, then press a key"
    }
    AddRemap(*) {
        if (!pending["from"] || !pending["to"] || pending["from"] = pending["to"]) {
            MsgBox("Pick two different keys first.", APP, "Iconi")
            return
        }
        SetRemap(pending["from"], pending["to"])
        pending["from"] := pending["to"] := 0
        btnFrom.Text := btnTo.Text := "Click, then press a key"
        SaveSettings(), ApplyRemaps(), RefreshRemapList()
    }
    RemoveRemap(*) {
        if !(row := lv.GetNext())
            return
        Remaps.RemoveAt(row)
        SaveSettings(), ApplyRemaps(), RefreshRemapList()
    }
    Import(*) {
        n := ImportPowerToys()
        SaveSettings(), ApplyRemaps(), RefreshRemapList()
        MsgBox(n ? "Imported " n " remap(s) from PowerToys." : "No PowerToys Keyboard Manager remaps found.", APP, "Iconi")
    }
    AddIsoFix(*) {
        for r in ISO_FIX_REMAPS
            SetRemap(r[1], r[2])
        SaveSettings(), ApplyRemaps(), RefreshRemapList()
        MsgBox("Added: the key left of 1 and the key next to the left Shift are swapped back. "
            . "If they were right before, remove the two remaps again.", APP, "Iconi")
    }
    btnFrom.OnEvent("Click", Capture.Bind(btnFrom, "from"))
    btnTo.OnEvent("Click", Capture.Bind(btnTo, "to"))
    btnAdd.OnEvent("Click", AddRemap)
    btnDel.OnEvent("Click", RemoveRemap)
    btnImp.OnEvent("Click", Import)
    btnIso.OnEvent("Click", AddIsoFix)
    RefreshRemapList()

    ; Battery
    tab.UseTab(4)
    AddBattCheck(key, label, opt) {
        cb := g.Add("CheckBox", opt " Checked" Cfg[key], label)
        cb.OnEvent("Click", (c, *) => (Cfg[key] := c.Value, SaveSettings(), ApplyBattery()))
    }
    AddBattNumber(key, lo, hi, suffix) {
        ed := g.Add("Edit", "xm+350 yp-3 w60 Number")     ; one aligned column for all numbers
        g.Add("UpDown", "Range" lo "-" hi, Cfg[key])
        g.Add("Text", "x+6 yp+3", suffix)
        ed.OnEvent("Change", (c, *) => BattNumberChanged(key, lo, hi, c))
    }
    g.Add("Text", "xm+14 ym+36 w530 cGray", "The battery is read from the keyboard over Bluetooth, no extra software needed.")
    AddBattCheck("Battery", "Show the battery level in the tray (icon tooltip and menu)", "xm+14 y+14")
    AddBattCheck("BattWarn", "Remind me to charge when the battery drops to", "xm+14 y+20")
    AddBattNumber("BattWarnLevel", 5, 95, "%")
    AddBattCheck("BattWarn2", "Second reminder at", "xm+14 y+14")
    AddBattNumber("BattWarn2Level", 1, 90, "%")
    g.Add("Text", "xm+14 y+16", "Repeat the reminder while it is still low, every")
    AddBattNumber("BattRepeatMin", 0, 1440, "min  (0 = only once)")
    g.Add("Text", "xm+14 y+16", "Check the battery at least every")
    AddBattNumber("BattCheckMin", 1, 60, "min")
    AddBattCheck("BattChargeIcon", "Show the charging icon (green bolt) while the keyboard is on power", "xm+14 y+22")
    AddBattCheck("BattLowIcon", "Show the low battery icon (orange dot) below the first reminder level", "xm+14 y+12")
    AddBattCheck("BattNotifyCharge", "Notify when charging starts and when the battery is full", "xm+14 y+12")
    btnTest := g.Add("Button", "xm+14 y+22 w150", "Test reminder")
    btnTest.OnEvent("Click", (*) => Notify("The Magic Keyboard battery is at " Cfg["BattWarnLevel"] "%. Time to charge it.", "Icon!"))

    ; Status
    tab.UseTab(5)
    g.Add("Text", "xm+14 ym+40 w120", "Keyboard battery:")
    stBatt := g.Add("Text", "x+4 w400")
    g.Add("Text", "xm+14 y+10 w120", "Time left:")
    stEst := g.Add("Text", "x+4 w400")
    g.Add("Text", "xm+14 y+22 w120", "Fn / Lock patch:")
    stPatch := g.Add("Text", "x+4 w400")
    btnPatch := g.Add("Button", "xm+138 y+8 w180", "Apply patch (admin)...")
    btnPatch.OnEvent("Click", (*) => Run('"' PATCH_BAT '"'))
    btnRestore := g.Add("Button", "x+8 w180", "Restore original...")
    btnRestore.OnEvent("Click", (*) => Run('"' PATCH_BAT '" -Restore'))
    g.Add("Text", "xm+14 y+22 w120", "Start with Windows:")
    stAuto := g.Add("Text", "x+4 w400 h36")
    g.Add("Text", "xm+14 y+10 w120", "PowerToys:")
    stPT := g.Add("Text", "x+4 w400 h36")
    btnRefresh := g.Add("Button", "xm+14 y+18 w120", "Refresh")
    btnRefresh.OnEvent("Click", (*) => RefreshStatus())
    g.Add("Text", "xm+14 y+22 w530 cGray", "Apply the patch again after pairing the keyboard again or reinstalling Windows. "
        . "It needs administrator rights and restarts the keyboard for a few seconds.")

    RefreshStatus() {
        info := Cfg["Battery"] ? ReadMagicKeyboardBattery() : ""
        stBatt.Text := !Cfg["Battery"] ? "Monitoring is off." : !info ? "Not available (keyboard not connected?)"
            : BatteryText(info) (BatteryConnection() = "usb" ? ", USB cable (Fn and Lock keys need Bluetooth)" : ", Bluetooth")
        est := BatteryEstimate()
        stEst.Text := est != "" ? StrTitle(SubStr(est, 1, 1)) SubStr(est, 2) " (from the discharge since the last charge)"
            : "Not enough data yet (needs a few hours of use after charging)."
        stPatch.Text := PatchStatusText()
        stAuto.Text := AutostartStatusText()
        stPT.Text := PowerToysRunning()
            ? "Keyboard Manager is running. Turn it off in PowerToys, this app handles the remaps now."
            : "Keyboard Manager is not running. OK"
        RefreshRemapList()
    }
    tab.OnEvent("Change", (*) => RefreshStatus())
    RefreshStatus()

    tab.UseTab()
    btnClose := g.Add("Button", "xm+464 ym+450 w96 Default", "Close")
    btnClose.OnEvent("Click", CloseSettings)
    tab.Choose(tabIndex)
    settingsGui := g
    g.Show()
}

CloseSettings(*) {
    global settingsGui
    if settingsGui
        settingsGui.Destroy()
    settingsGui := 0
}

FeatureToggled(id, ctrl, *) {
    Cfg[id] := ctrl.Value
    SaveSettings()
    ApplyFeatures()
    if (id = "PatchWarn" && ctrl.Value)
        CheckPatch()
}

FnKeyChanged(i, ctrl, *) {
    Cfg["FnKey" i] := ACTION_ORDER[ctrl.Value]
    SaveSettings()
}

BattNumberChanged(key, lo, hi, ctrl) {
    if (ctrl.Value ~= "^\d+$") && (ctrl.Value >= lo) && (ctrl.Value <= hi) {
        Cfg[key] := Integer(ctrl.Value)
        SaveSettings()
        ApplyBattery()
    }
}

StepChanged(ctrl, *) {
    if (ctrl.Value ~= "^\d+$") && (ctrl.Value >= 1) && (ctrl.Value <= 50) {
        Cfg["BrightnessStep"] := Integer(ctrl.Value)
        SaveSettings()
    }
}

; ─── Battery level (Bluetooth HID, report 0x90) ──────────────────────────
; The keyboard reports the battery on its vendor HID collection (COL02, UsagePage
; 0xFF00 / Usage 0x14) in input report 0x90 (Battery System page 0x85):
;   byte 1: flags (bit0 = on external power, bit1 = charging, bit2 = fully charged)
;   byte 2: charge in percent (0-100)
; Unlike the keyboard collection (COL01) this one can be read from user mode
; with a GET_REPORT request (IOCTL_HID_GET_INPUT_REPORT), no driver needed.
; On a wall charger the keyboard stays on Bluetooth and reports 90 03 xx.

ApplyBattery() {
    if Cfg["Battery"] {
        UpdateBattery()
    } else {
        SetTimer(UpdateBattery, 0)
        StopBatteryListener()
        SetBatteryText("Battery: monitoring off")
        SetTrayIcon("normal")
    }
}

SetTrayIcon(state) {
    global trayIconState
    if (state = trayIconState)
        return
    trayIconState := state
    file := (state = "charging") ? ICON_CHARGING : (state = "low") ? ICON_LOW : ICON_FILE
    if !FileExist(file)
        file := ICON_FILE
    if FileExist(file)
        TraySetIcon(file, , true)       ; frozen, so Suspend (key capture) does not swap it
    else
        TraySetIcon("shell32.dll", 233, true)
}

; Bluetooth: HID\{00001124-...}_VID&0001004C_PID&029C&COL02 (battery collection)
; USB cable: HID\VID_05AC&PID_029C&MI_00&COL02 (battery), but MI_01&COL02 is the
; consumer (media) collection, so every candidate is tried and Bluetooth wins.
FindBatteryPath() {
    found := ""
    try {
        for dev in ComObjGet("winmgmts:").ExecQuery("SELECT PNPDeviceID FROM Win32_PnPEntity WHERE PNPDeviceID LIKE '%PID%029C%COL%'") {
            path := "\\?\" StrReplace(dev.PNPDeviceID, "\", "#") "#{4d1e55b2-f16f-11cf-88cb-001111000030}"
            if !ReadBatteryReport(path)
                continue
            if !InStr(path, "VID_05AC")
                return path             ; Bluetooth
            found := path               ; USB, keep looking for Bluetooth
        }
    }
    return found
}

BatteryConnection() => battPath = "" ? "" : InStr(battPath, "VID_05AC") ? "usb" : "bluetooth"

ReadBatteryReport(path) {
    ; zero access + FILE_FLAG_OVERLAPPED, so we can wait with a timeout (the script never hangs)
    h := DllCall("CreateFileW", "Str", path, "UInt", 0, "UInt", 3, "Ptr", 0, "UInt", 3, "UInt", 0x40000000, "Ptr", 0, "Ptr")
    if (h = -1)
        return ""
    buf := Buffer(3, 0)
    NumPut("UChar", 0x90, buf)
    ov := Buffer(A_PtrSize * 3 + 8, 0)
    ev := DllCall("CreateEventW", "Ptr", 0, "Int", 1, "Int", 0, "Ptr", 0, "Ptr")
    NumPut("Ptr", ev, ov, A_PtrSize * 2 + 8)
    ok := DllCall("DeviceIoControl", "Ptr", h, "UInt", 0xB01A2, "Ptr", 0, "UInt", 0
        , "Ptr", buf, "UInt", 3, "Ptr", 0, "Ptr", ov)   ; 0xB01A2 = IOCTL_HID_GET_INPUT_REPORT
    if (!ok && A_LastError = 997) {                  ; ERROR_IO_PENDING
        if (DllCall("WaitForSingleObject", "Ptr", ev, "UInt", 2000) != 0)
            DllCall("CancelIoEx", "Ptr", h, "Ptr", ov)
        ok := DllCall("GetOverlappedResult", "Ptr", h, "Ptr", ov, "UInt*", &got := 0, "Int", 1)
    }
    DllCall("CloseHandle", "Ptr", ev)
    DllCall("CloseHandle", "Ptr", h)
    return ok ? ParseBatteryReport(buf) : ""
}

ParseBatteryReport(buf) {
    if (NumGet(buf, 0, "UChar") != 0x90 || NumGet(buf, 2, "UChar") > 100)
        return ""
    flags := NumGet(buf, 1, "UChar")
    return {percent: NumGet(buf, 2, "UChar"), power: (flags & 0x01) != 0,
        charging: (flags & 0x02) != 0, full: (flags & 0x04) != 0}
}

ReadMagicKeyboardBattery() {
    global battPath, patchWarned
    ; the device path is cached, the WMI lookup only runs after a failure (e.g. reconnect)
    if (battPath != "" && (info := ReadBatteryReport(battPath)))
        return info
    old := battPath
    battPath := FindBatteryPath()
    if (battPath != old)
        StopBatteryListener()           ; the live reader belongs to the old device
    if (battPath != "" && battPath != old) {
        if (BatteryConnection() = "usb") {
            Notify("The Magic Keyboard is connected by USB cable. The Fn and Lock keys only work "
                . "over Bluetooth: unplug the cable when it is charged, or use a wall charger.", "Iconi")
        } else if (old != "") {
            patchWarned := false        ; the keyboard came back as a new device: maybe paired again
            SetTimer(CheckPatch, -3000)
        }
    }
    return battPath != "" ? ReadBatteryReport(battPath) : ""
}

BatteryText(info) => info.percent "%" (info.full ? " (fully charged)" : info.charging ? " (charging)" : "")

SetBatteryText(text, tip := "") {
    global battMenuName
    A_IconTip := APP "`n" (tip != "" ? tip : text)
    if (text != battMenuName) {
        A_TrayMenu.Rename(battMenuName, text)
        battMenuName := text
    }
}

; Discharge history -> time left. Samples are kept only while discharging and
; cleared when the keyboard is charged; they survive restarts (settings.ini).
RecordBattery(info, state) {
    global battHistory
    if (state != "discharging") {
        if battHistory.Length {
            battHistory := []
            SaveBatteryHistory()
        }
        return
    }
    if (!battHistory.Length || battHistory[-1][2] != info.percent) {
        battHistory.Push([A_Now, info.percent])
        while (battHistory.Length > 120)
            battHistory.RemoveAt(1)
        SaveBatteryHistory()
    }
}

SaveBatteryHistory() {
    s := ""
    for smp in battHistory
        s .= (s = "" ? "" : ",") smp[1] ":" smp[2]
    IniWrite(s, INI_FILE, "BatteryHistory", "Samples")
}

BatteryEstimate() {
    if (battHistory.Length < 2)
        return ""
    first := battHistory[1], last := battHistory[-1]
    drop := first[2] - last[2]
    hours := DateDiff(last[1], first[1], "Minutes") / 60
    if (drop < 2 || hours < 3)
        return ""
    left := last[2] / (drop / hours)    ; hours at the measured discharge rate
    return left >= 48 ? "about " Round(left / 24) " days left" : "about " Round(left) " hours left"
}

; ─── Live battery reports ─────────────────────────────────────────────────
; The keyboard also sends report 0x90 on its own when the charge or the power
; state changes. An overlapped ReadFile stays pending on COL02 and a 500 ms timer
; checks it (no blocking), so plugging / unplugging the charger shows up at once.
; The periodic GET_REPORT poll stays as a fallback.

StartBatteryListener() {
    if (battListen.h || battPath = "")
        return
    h := DllCall("CreateFileW", "Str", battPath, "UInt", 0x80000000, "UInt", 3, "Ptr", 0, "UInt", 3, "UInt", 0x40000000, "Ptr", 0, "Ptr")
    if (h = -1)
        return
    battListen.h := h
    battListen.ev := DllCall("CreateEventW", "Ptr", 0, "Int", 1, "Int", 0, "Ptr", 0, "Ptr")
    if IssueBatteryRead()
        SetTimer(CheckBatteryListener, 500)
}

IssueBatteryRead() {
    battListen.ov := Buffer(A_PtrSize * 3 + 8, 0)    ; fresh OVERLAPPED (the previous read has completed)
    DllCall("ResetEvent", "Ptr", battListen.ev)
    NumPut("Ptr", battListen.ev, battListen.ov, A_PtrSize * 2 + 8)
    ok := DllCall("ReadFile", "Ptr", battListen.h, "Ptr", battListen.buf, "UInt", 3, "Ptr", 0, "Ptr", battListen.ov)
    if (!ok && A_LastError != 997) {                 ; not ERROR_IO_PENDING: device gone
        StopBatteryListener()
        return false
    }
    return true
}

CheckBatteryListener() {
    if !battListen.h
        return
    if (DllCall("WaitForSingleObject", "Ptr", battListen.ev, "UInt", 0) != 0)
        return                                       ; nothing arrived yet
    if !DllCall("GetOverlappedResult", "Ptr", battListen.h, "Ptr", battListen.ov, "UInt*", &n := 0, "Int", 0) {
        StopBatteryListener()                        ; keyboard disconnected or switched to USB / Bluetooth
        SetTimer(UpdateBattery, -2000)               ; look for it again soon
        return
    }
    info := (n >= 3) ? ParseBatteryReport(battListen.buf) : ""
    if (IssueBatteryRead() && info && Cfg["Battery"])
        ProcessBattery(info)
}

StopBatteryListener() {
    SetTimer(CheckBatteryListener, 0)
    if battListen.h {
        DllCall("CancelIoEx", "Ptr", battListen.h, "Ptr", battListen.ov)
        DllCall("GetOverlappedResult", "Ptr", battListen.h, "Ptr", battListen.ov, "UInt*", &n := 0, "Int", 1)
        DllCall("CloseHandle", "Ptr", battListen.h)
        DllCall("CloseHandle", "Ptr", battListen.ev)
    }
    battListen.h := battListen.ev := 0
}

; Plugging the USB cable in or out, or the keyboard reconnecting over Bluetooth,
; changes the device tree (DBT_DEVNODES_CHANGED = 7). Re-read the battery shortly
; after, debounced, instead of waiting for the next poll.
DeviceChanged(wParam, *) {
    if (wParam = 0x0007 && Cfg["Battery"])
        SetTimer(UpdateBattery, -2500)
}

; NOTE: AutoHotkey names are case-insensitive, so no variable may be called "notify"
; (it would hide the Notify() function inside the function).
UpdateBattery(announce := false) {
    if !Cfg["Battery"] {
        StopBatteryListener()
        return
    }
    info := ReadMagicKeyboardBattery()
    if !info {
        StopBatteryListener()
        SetBatteryText("Battery: not available")
        SetTrayIcon("normal")
        SetTimer(UpdateBattery, -60000)              ; keyboard not connected: retry every minute
        return
    }
    StartBatteryListener()
    SetTimer(UpdateBattery, -Max(1, Cfg["BattCheckMin"]) * 60000)
    ProcessBattery(info, announce)
}

ProcessBattery(info, announce := false) {
    global battWarnedLevel, battLastWarnTick, battLastState, battLastInfo
    battLastInfo := info
    state := info.full ? "full" : info.charging ? "charging" : "discharging"
    RecordBattery(info, state)
    text := "Battery: " BatteryText(info)
    est := state = "discharging" ? BatteryEstimate() : ""
    SetBatteryText(text, est != "" ? text ", " est : text)
    if (Cfg["BattChargeIcon"] && (info.charging || info.power))
        SetTrayIcon("charging")
    else if (Cfg["BattLowIcon"] && state = "discharging" && info.percent <= Cfg["BattWarnLevel"])
        SetTrayIcon("low")
    else
        SetTrayIcon("normal")

    if (Cfg["BattNotifyCharge"] && battLastState != "" && state != battLastState) {
        if (state = "charging")
            Notify("The Magic Keyboard is charging (" info.percent "%).", "Iconi Mute")
        else if (state = "full")
            Notify("The Magic Keyboard is fully charged. You can unplug it.")
        announce := false
    }
    battLastState := state

    if (state != "discharging") {
        battWarnedLevel := 101                       ; re-arm the reminders after charging
    } else {
        crossed := 0                                 ; lowest enabled level the charge is under
        for lvl in [Cfg["BattWarn"] ? Cfg["BattWarnLevel"] : 0, Cfg["BattWarn2"] ? Cfg["BattWarn2Level"] : 0]
            if (lvl && info.percent <= lvl && (!crossed || lvl < crossed))
                crossed := lvl
        repeatDue := Cfg["BattRepeatMin"] > 0 && A_TickCount - battLastWarnTick >= Cfg["BattRepeatMin"] * 60000
        if (crossed && (crossed < battWarnedLevel || repeatDue)) {
            battWarnedLevel := Min(battWarnedLevel, crossed)
            battLastWarnTick := A_TickCount
            Notify("The Magic Keyboard battery is at " info.percent "%"
                . (est != "" ? " (" est ")" : "") ". Time to charge it.", "Icon!")
            announce := false
        }
    }
    if announce
        Notify(est != "" ? text ", " est : text)
}

; ─── Double-tap F5 = Dictation ───────────────────────────────────────────
; Single F5 -> normal F5 (refresh), ~300 ms later
; Two quick taps (within 300 ms) -> Dictation (Win+H)

F5TapHandler(*) {
    global f5TapCount
    f5TapCount += 1
    if (f5TapCount = 1) {
        SetTimer(F5TapTimeout, -300)      ; wait for a possible second tap
    } else {
        SetTimer(F5TapTimeout, 0)
        f5TapCount := 0
        Send("#h")
    }
}

F5TapTimeout() {
    global f5TapCount
    if (f5TapCount = 1)
        Send("{F5}")                      ; no second tap -> plain F5
    f5TapCount := 0
}

; ─── Volume (16 steps, like the Mac) ─────────────────────────────────────
; With the on-screen display on, the volume is set directly (no Windows flyout),
; otherwise the normal media keys are sent.

VolumeStep(dir) {
    if !Cfg["OSD"] {
        Send(dir > 0 ? "{Volume_Up}" : "{Volume_Down}")
        return
    }
    try {
        v := Round(SoundGetVolume() / VOLUME_STEP) * VOLUME_STEP + dir * VOLUME_STEP
        v := Max(0, Min(100, v))
        SoundSetVolume(v)
        if (dir > 0 && SoundGetMute())
            SoundSetMute(false)
        ShowOSD("volume", v, SoundGetMute())
    } catch {
        Send(dir > 0 ? "{Volume_Up}" : "{Volume_Down}")    ; no default audio device
    }
}

VolumeMute() {
    if !Cfg["OSD"] {
        Send("{Volume_Mute}")
        return
    }
    try {
        SoundSetMute(-1)
        ShowOSD("volume", SoundGetVolume(), SoundGetMute())
    } catch {
        Send("{Volume_Mute}")
    }
}

; ─── Brightness (built-in laptop screen + DDC/CI external monitors) ──────
; Built-in screens (laptops, tablets) are set through WMI (WmiMonitorBrightness),
; external monitors directly over DDC/CI (dxva2.dll). Each display steps from its
; own level. On a desktop PC WMI has no brightness classes ("Not supported").

; Built-in screen: returns the new level (0-100), or -1 if there is none.
; After a failure WMI is only asked again a minute later (fast on desktop PCs,
; still finds the screen when a docked laptop is opened later).
LaptopBrightness(delta) {
    static failTick := 0
    if (failTick && A_TickCount - failTick < 60000)
        return -1
    try {
        wmi := ComObjGet("winmgmts:\\.\root\WMI")
        cur := -1
        for b in wmi.ExecQuery("SELECT CurrentBrightness FROM WmiMonitorBrightness WHERE Active=TRUE") {
            cur := b.CurrentBrightness
            break
        }
        if (cur >= 0) {
            val := Max(0, Min(100, cur + delta))
            for m in wmi.ExecQuery("SELECT * FROM WmiMonitorBrightnessMethods WHERE Active=TRUE")
                m.WmiSetBrightness(1, val)
            failTick := 0
            return val
        }
    }
    failTick := A_TickCount
    return -1
}

BrightnessChange(delta) {
    levels := []
    if ((builtIn := LaptopBrightness(delta)) >= 0)
        levels.Push(builtIn)
    Loop MonitorGetCount() {
        MonitorGet(A_Index, &l, &t)
        hMon := DllCall("MonitorFromPoint", "Int64", ((t + 1) << 32) | ((l + 1) & 0xFFFFFFFF), "UInt", 2, "Ptr")
        if !DllCall("dxva2\GetNumberOfPhysicalMonitorsFromHMONITOR", "Ptr", hMon, "UInt*", &n := 0) || !n
            continue
        size := A_PtrSize + 256                ; PHYSICAL_MONITOR: HANDLE + WCHAR[128]
        pm := Buffer(size * n, 0)
        if !DllCall("dxva2\GetPhysicalMonitorsFromHMONITOR", "Ptr", hMon, "UInt", n, "Ptr", pm)
            continue
        Loop n {
            h := NumGet(pm, (A_Index - 1) * size, "Ptr")
            if DllCall("dxva2\GetMonitorBrightness", "Ptr", h, "UInt*", &mn := 0, "UInt*", &cur := 0, "UInt*", &mx := 0) {
                val := Max(mn, Min(mx, cur + delta))
                DllCall("dxva2\SetMonitorBrightness", "Ptr", h, "UInt", val)
                levels.Push(Round((val - mn) * 100 / Max(1, mx - mn)))
            }
        }
        DllCall("dxva2\DestroyPhysicalMonitors", "UInt", n, "Ptr", pm)
    }
    caption := ""
    for lv in levels
        caption .= (caption = "" ? "" : "  |  ") lv "%"
    if Cfg["OSD"] {
        if levels.Length
            ShowOSD("brightness", levels[1], false, levels.Length > 1 ? caption : "")
        else
            ShowOSD("brightness", 0, false, "No adjustable display")
    } else {
        ToolTip(levels.Length ? "Brightness: " caption : "Brightness cannot be changed (no built-in screen or DDC/CI monitor)")
        SetTimer(() => ToolTip(), -1200)
    }
}

; ─── On-screen display (Mac-style bezel) ─────────────────────────────────
; A rounded, dark, click-through box near the bottom middle of the screen the
; mouse is on: big icon, 16 segments, small caption. Fades out after ~1.2 s.

BuildOSD() {
    s := A_ScreenDPI / 96
    W := Round(200 * s), H := Round(200 * s)
    g := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x08000020 -DPIScale")   ; no-activate + click-through
    g.BackColor := "1E1E1E"
    g.MarginX := g.MarginY := 0
    g.SetFont("s54 cFFFFFF", "Segoe Fluent Icons")
    osd.icon := g.Add("Text", "x0 y" Round(26 * s) " w" W " h" Round(100 * s) " Center BackgroundTrans", Chr(0xE706))
    segW := Round(8 * s), gap := Round(2 * s), segH := Round(6 * s)
    x := (W - (16 * segW + 15 * gap)) // 2
    osd.segs := []
    Loop 16 {
        osd.segs.Push(g.Add("Text", "x" x " y" Round(142 * s) " w" segW " h" segH " Background505050"))
        x += segW + gap
    }
    g.SetFont("s9 cB8B8B8", "Segoe UI")
    osd.text := g.Add("Text", "x0 y" Round(160 * s) " w" W " h" Round(22 * s) " Center BackgroundTrans")
    g.Show("Hide w" W " h" H)
    DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", g.Hwnd, "UInt", 33, "Int*", 2, "UInt", 4)   ; rounded corners
    osd.gui := g
    osd.w := W, osd.h := H
}

ShowOSD(kind, pct, muted := false, caption := "") {
    if !osd.gui
        BuildOSD()
    if (kind = "brightness")
        glyph := 0xE706
    else if (kind = "power")
        glyph := 0xE7E8                 ; power button, no level bar
    else
        glyph := (muted || pct <= 0) ? 0xE74F : pct < 34 ? 0xE993 : pct < 67 ? 0xE994 : 0xE995
    osd.icon.Text := Chr(glyph)
    filled := muted ? 0 : Round(pct / VOLUME_STEP)
    for i, seg in osd.segs {
        seg.Visible := (kind != "power")
        seg.Opt("+Background" (i <= filled ? "FFFFFF" : "505050"))
        seg.Redraw()
    }
    osd.text.Text := caption != "" ? caption : muted ? "Muted" : Round(pct) "%"
    ; centre it on the monitor under the mouse, at about 3/4 of the height
    CoordMode("Mouse", "Screen")
    MouseGetPos(&mx, &my)
    mon := MonitorGetPrimary()
    Loop MonitorGetCount() {
        MonitorGet(A_Index, &l, &t, &r, &b)
        if (mx >= l && mx < r && my >= t && my < b)
            mon := A_Index
    }
    MonitorGetWorkArea(mon, &l, &t, &r, &b)
    x := l + (r - l - osd.w) // 2
    y := t + Round((b - t) * 0.74) - osd.h // 2
    osd.alpha := 235
    WinSetTransparent(osd.alpha, osd.gui)
    osd.gui.Show("NA x" x " y" y)
    SetTimer(FadeOSD, -1200)
}

FadeOSD() {
    osd.alpha -= 35
    if (osd.alpha <= 0) {
        osd.gui.Hide()
        return
    }
    WinSetTransparent(osd.alpha, osd.gui)
    SetTimer(FadeOSD, -25)
}
